{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@brain/*": ["../../packages/brain/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../packages/brain/src/**/*.ts"],
  "exclude": ["node_modules"]
}
