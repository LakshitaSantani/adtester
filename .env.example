# Leave DATABASE_URL unset to use the embedded Postgres (PGlite) in ./data/pg.
# Set it to a real Postgres connection string when you deploy — the SQL is
# identical, so there is no migration.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Where session recordings are written. One file per session.
DATA_DIR=./data

# Public origin of this app, used in the install snippet shown in the UI.
PUBLIC_ORIGIN=http://localhost:3000

# Encrypts stored credentials. If unset, a key is generated into
# data/secret.key -- which sits beside the database, so anyone who can read
# one can read the other. Setting this keeps the key somewhere else, which is
# the whole point.
# SWY_SECRET=a-long-random-string
